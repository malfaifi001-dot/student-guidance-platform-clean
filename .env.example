# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/teachix"

# Authentication
# Production must use a strong random value.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-strong-random-secret"
AUTH_SINGLE_ACTIVE_SESSION="true"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
PASSWORD_RESET_WEBHOOK_URL=""
PASSWORD_RESET_WEBHOOK_SECRET=""

# Environment
NODE_ENV="development"

# PDF export backend for report-2 (Puppeteer)
# Set to "print-preview" to skip Puppeteer and use browser print-to-PDF fallback.
# Useful on shared hosting (e.g. Hostinger) where Chromium cannot run.
# When unset or set to any other value, Puppeteer is tried first, then falls back to print preview on failure.
REPORT_TWO_PDF_BACKEND=""

# Optional/production services (names only; provide real values outside source control)
ACTIVITY_PLAN_SHARE_TOKEN_ENCRYPTION_KEY="replace-with-strong-random-secret"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_BROWSER_RUN_API_TOKEN=""
TEACHIX_STORAGE_ROOT=""
