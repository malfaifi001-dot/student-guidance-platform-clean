                <div>الموجه/الموجهة الطلابية</div>
                <div className="mx-auto mt-7 w-[48mm] border-b border-dotted border-slate-900" />
              </td>

              <td className="w-1/2">
                <div>قائد/قائدة المدرسة</div>
                <div className="mx-auto mt-7 w-[48mm] border-b border-dotted border-slate-900" />
