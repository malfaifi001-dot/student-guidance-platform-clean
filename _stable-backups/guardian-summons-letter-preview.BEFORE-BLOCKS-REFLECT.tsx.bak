              <td className="border-b border-dotted border-slate-900 px-3 text-center font-black">
                {guardianName}
              </td>

              <td className="w-[13mm] whitespace-nowrap text-center">
                بشأن
              </td>

              <td className="border-b border-dotted border-slate-900 px-3 text-center font-black">
                {studentName}
              </td>
            </tr>
          </tbody>
        </table>

        <table className="mt-2 w-full table-fixed border-collapse text-[15px] font-bold leading-9">
          <tbody>
            <tr>
              <td className="w-[22mm] whitespace-nowrap text-right">
                الطالب في الصف
              </td>

              <td className="border-b border-dotted border-slate-900 px-3 text-center font-black">
                {studentClass}
              </td>

              <td className="w-[25mm] whitespace-nowrap text-left">
                سلمه الله
              </td>
            </tr>
          </tbody>
        </table>

        <section className="mt-7 text-center text-[15px] font-bold leading-9">
