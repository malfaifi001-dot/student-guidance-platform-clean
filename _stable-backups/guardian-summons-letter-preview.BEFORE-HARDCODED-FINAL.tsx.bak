}

function TextBlock({
  block,
  snippets,
  fallbackText,
}: {
  block: TemplateBlock;
  snippets: unknown;
  fallbackText: string;
}) {
  const text =
    resolveSnippetText(block, snippets) ||
    normalizeText(block.description) ||
    fallbackText;

  return (
    <section className="mx-auto mt-7 max-w-[165mm] text-center text-[15px] font-semibold leading-[2.1]">
      {text.split("\n").map((line, index) => (
        <p key={`${line}-${index}`} className={index ? "mt-2" : ""}>
          {line}
        </p>
      ))}
    </section>
  );
}

function DynamicFieldBlock({
  block,
  values,
}: {
  block: TemplateBlock;
  values: LetterValues;
}) {
  const fieldKey = block.source?.fieldKey || "";

  if (
    !fieldKey ||
    [
      "summonDay",
      "summonsDay",
      "summonDate",
      "summonsHijriDate",
      "summonTime",
      "summonsTime",
      "summonPeriod",
      "summonsPeriod",
    ].includes(fieldKey)
  ) {
    return <SummonsAppointmentBlock values={values} />;
  }

  if (["summonReason", "summonsReason", "reason"].includes(fieldKey)) {
    return <ReasonsBlock values={values} />;
  }

  if (["notes", "printNotes", "summonNotes"].includes(fieldKey)) {
    return values.notes ? <NotesBlock notes={values.notes} /> : null;
  }

  return (
    <section className="mx-auto mt-6 w-[150mm] rounded-2xl border border-slate-200 bg-white px-4 py-3 text-[13px] font-bold leading-7 text-slate-700">
      <span className="font-black text-slate-900">
        {block.title || block.source?.label || fieldKey}:{" "}
      </span>
      {getValueByCanonicalKey(values, fieldKey)}
    </section>
  );
}

function SummonsAppointmentBlock({ values }: { values: LetterValues }) {
  return (
    <section className="mt-7 rounded-2xl border border-slate-200 bg-slate-50 px-5 py-4">
      <table className="w-full table-fixed border-collapse text-[14px] font-bold leading-8">
        <tbody>
          <tr>
            <td className="w-[38mm] whitespace-nowrap text-right">
              لذا نأمل منكم الحضور
            </td>

            <td className="w-[10mm] text-center">يوم</td>

            <td className="w-[30mm] border-b border-dotted border-slate-900 px-2 text-center font-black">
              {values.summonDay}
            </td>

            <td className="w-[18mm] text-center">الموافق</td>

            <td className="border-b border-dotted border-slate-900 px-2 text-center font-black">
              {values.summonDate}
            </td>
          </tr>
        </tbody>
      </table>

      <table className="mt-2 w-full table-fixed border-collapse text-[14px] font-bold leading-8">
        <tbody>
          <tr>
            <td className="w-[22mm] text-right">الساعة</td>

            <td className="w-[35mm] border-b border-dotted border-slate-900 px-2 text-center font-black">
              {values.summonTime}
            </td>

            <td className="w-[16mm] text-center">الفترة</td>

            <td className="w-[35mm] border-b border-dotted border-slate-900 px-2 text-center font-black">
              {values.summonPeriod}
            </td>

            <td />
          </tr>
        </tbody>
      </table>
    </section>
  );
}

function ReasonsBlock({ values }: { values: LetterValues }) {
