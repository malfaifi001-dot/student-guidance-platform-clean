}

function BlockRenderer({
  block,
  values,
  snippets,
}: {
  block: TemplateBlock;
  values: LetterValues;
  snippets: unknown;
  index: number;
}) {
  const kind = block.kind || "custom-paragraph";

  if (kind === "identity-header") {
    return null;
  }

  if (kind === "cover-title") {
    return <LetterTitle title={block.title || "استدعاء ولي أمر طالب"} />;
  }

  if (kind === "case-meta" || kind === "student-summary") {
    return <StudentGuardianBlock values={values} />;
  }

  if (
    kind === "paragraph" ||
    kind === "custom-paragraph" ||
    kind === "text-library" ||
    kind === "service-summary"
  ) {
    return (
      <TextBlock
        block={block}
        snippets={snippets}
        fallbackText={
          "السلام عليكم ورحمة الله وبركاته ،،،\nنظرًا لأهمية التعاون المستمر والتنسيق بين المدرسة وولي أمر الطالب فيما يخدم مصلحته ويحقق له النجاح بإذن الله."
        }
      />
    );
  }

  if (kind === "field-list") {
    return <DynamicFieldBlock block={block} values={values} />;
  }

  if (kind === "approval-signature") {
    return <ApprovalBlock />;
  }

  if (kind === "evidence-gallery") {
    return null;
  }

  return (
    <section className="mt-6 rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3 text-center text-[13px] font-bold text-slate-600">
      {block.title || "بلوك مخصص"}
    </section>
  );
}

function LetterTitle({ title }: { title: string }) {
  return (
    <h1 className="mt-7 text-center text-[29px] font-black tracking-tight">
      {title}
    </h1>
  );
}

function StudentGuardianBlock({ values }: { values: LetterValues }) {
