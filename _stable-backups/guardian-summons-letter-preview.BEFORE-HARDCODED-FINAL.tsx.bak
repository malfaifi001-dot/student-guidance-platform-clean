import type { RuntimePreviewCaseData } from "@/lib/report-engine/report-template-runtime-types";

type GuardianSummonsLetterPreviewProps = {
  template?: unknown;
  previewCaseData?: RuntimePreviewCaseData | null;
  snippets?: unknown;
  pdfMode?: boolean;
  forceOfficialHeader?: boolean;
  showDynamicFields?: boolean;
};

type PreviewValue = {
  fieldKey?: string;
  fieldLabel?: string;
  value?: unknown;
};

type TemplateBlock = {
  id?: string;
  kind?: string;
  title?: string;
  description?: string;
  required?: boolean;
  source?: {
    source?: string;
    label?: string;
    description?: string;
    fieldKey?: string;
    snippetId?: string;
  };
  settings?: Record<string, unknown>;
};

type TemplatePage = {
  id?: string;
  kind?: string;
  title?: string;
  description?: string;
  blocks?: TemplateBlock[];
};

type TemplateLike = {
  id?: string;
  name?: string;
  description?: string;
  status?: string;
  designPreset?: string;
  pages?: TemplatePage[];
};

type LetterValues = ReturnType<typeof buildLetterValues>;

