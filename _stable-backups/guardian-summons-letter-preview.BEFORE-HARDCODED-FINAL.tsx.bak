function DynamicFieldsPanel() {
  return (
    <section className="rounded-3xl border border-slate-200 bg-slate-50 p-4">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h3 className="text-sm font-black text-slate-900">
            الحقول الديناميكية أسفل الترويسة
          </h3>

          <p className="mt-1 text-xs leading-6 text-slate-500">
            الترويسة ثابتة. هذه الحقول يمكن استخدامها في البلوكات ومكتبة النصوص.
          </p>
        </div>

        <span className="rounded-full bg-white px-3 py-1 text-[11px] font-black text-slate-500">
          {guardianSummonsDynamicFields.length} حقل
        </span>
      </div>

      <div className="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3">
        {guardianSummonsDynamicFields.map((field) => (
          <div
            key={field.key}
            className="rounded-2xl border border-slate-200 bg-white p-3"
          >
            <div className="text-xs font-black text-emerald-700">
              {field.label}
            </div>

            <code className="mt-1 block rounded-lg bg-slate-100 px-2 py-1 text-left text-[11px] font-bold text-slate-700">
              {field.key}
            </code>

            <p className="mt-2 text-[11px] leading-5 text-slate-500">
              {field.description}
            </p>
          </div>
        ))}
      </div>
    </section>
  );
}

function MinistryLogoMark() {
  return (
    <div className="relative h-[34px] w-[86px]" aria-hidden="true">
      <span className="absolute left-[10px] top-[8px] h-2 w-2 rounded-full bg-sky-500" />
      <span className="absolute left-[24px] top-[3px] h-2 w-2 rounded-full bg-emerald-500" />
      <span className="absolute left-[38px] top-[9px] h-2 w-2 rounded-full bg-sky-500" />
      <span className="absolute left-[52px] top-[4px] h-2 w-2 rounded-full bg-emerald-500" />
      <span className="absolute left-[66px] top-[10px] h-2 w-2 rounded-full bg-sky-500" />
      <span className="absolute left-[18px] top-[20px] h-2 w-2 rounded-full bg-emerald-500" />
      <span className="absolute left-[34px] top-[22px] h-2 w-2 rounded-full bg-sky-500" />
      <span className="absolute left-[50px] top-[20px] h-2 w-2 rounded-full bg-emerald-500" />
    </div>
  );
}

function buildLetterValues(data: RuntimePreviewCaseData) {
  return {
    studentName:
      getValue(data, ["studentName", "student_name"]) ||
      data.student?.name ||
      "........................",

    studentClass:
      getValue(data, ["studentClass", "student_class"]) ||
      [data.student?.grade, data.student?.classroom].filter(Boolean).join(" / ") ||
      "........................",

    studentNationalId:
      getValue(data, ["studentNationalId", "nationalId"]) ||
      data.student?.nationalId ||
      "",

    guardianName:
      getValue(data, ["guardianName", "guardian_name", "parentName"]) ||
      data.student?.guardianName ||
      "ولي أمر الطالب",

    guardianPhone:
      getValue(data, ["guardianPhone", "guardian_phone", "parentPhone"]) ||
      data.student?.guardianPhone ||
      "",

    summonDay:
      getValue(data, ["summonDay", "summonsDay", "attendanceDay", "day"]) ||
      "........................",

    summonDate:
      getValue(data, [
        "summonDate",
        "summonsDate",
        "summonsHijriDate",
        "attendanceDate",
        "date",
      ]) || "........................",

    summonTime:
      getValue(data, ["summonTime", "summonsTime", "attendanceTime", "time"]) ||
      "09:00",

    summonPeriod:
      getValue(data, ["summonPeriod", "summonsPeriod", "period"]) || "صباحًا",

    summonReason:
      getValue(data, ["summonReason", "summonsReason", "reason"]) ||
      "غيابه المتكرر لأكثر من خمسة أيام بدون عذر.",

    notes: getValue(data, ["notes", "printNotes", "summonNotes"]),
  };
}

function getTemplateBlocks(template: unknown) {
  const item = template as TemplateLike | null;

  if (!item || typeof item !== "object") {
    return defaultGuardianSummonsBlocks;
  }

  if (!Array.isArray(item.pages) || item.pages.length === 0) {
    return defaultGuardianSummonsBlocks;
  }

  const firstPage = item.pages[0];

  if (!firstPage || typeof firstPage !== "object") {
    return defaultGuardianSummonsBlocks;
  }

  if (!Array.isArray(firstPage.blocks)) {
    return defaultGuardianSummonsBlocks;
  }

  return firstPage.blocks;
}

function withDefaultSource(block: TemplateBlock): TemplateBlock {
  if (block.source) return block;

  if (
    block.kind === "field-list" ||
    block.kind === "student-summary" ||
    block.kind === "case-meta"
  ) {
    return {
      ...block,
      source: {
        source: "caseValues",
        label: "بيانات الحالة",
        description: "حقول ديناميكية من بيانات الحالة.",
        fieldKey: "studentName",
      },
    };
  }

  if (block.kind === "approval-signature") {
    return {
      ...block,
      source: {
        source: "identity",
        label: "الاعتماد",
        description: "بيانات الاعتماد والتوقيع.",
      },
    };
  }

  return {
    ...block,
    source: {
      source: "template",
      label: "محتوى القالب",
      description: "بلوك ثابت من القالب.",
    },
  };
}

function getValue(data: RuntimePreviewCaseData, keys: string[]) {
  const values = Array.isArray(data.values)
    ? (data.values as PreviewValue[])
    : [];

  for (const key of keys) {
    const item = values.find((value) => value.fieldKey === key);

    if (
      item?.value !== undefined &&
      item.value !== null &&
      String(item.value).trim()
    ) {
      return String(item.value).trim();
    }
  }

  return "";
}

function splitReasons(value: string) {
  const reasons = value
    .split("،")
    .map((item) => item.trim())
    .filter(Boolean);

  return reasons.length ? reasons : [value];
}

function normalizeText(value?: string) {
  if (!value) return "";

  return value.trim();
}

function normalizeTemplateInfo(template: unknown) {
  if (!template || typeof template !== "object") {
    return {
      name: guardianSummonsTemplatePreset.name,
      description: guardianSummonsTemplatePreset.description,
      sourceLabel: "قالب رسمي",
    };
  }

  const item = template as {
    name?: unknown;
    description?: unknown;
    status?: unknown;
  };

  return {
    name:
      typeof item.name === "string" && item.name.trim()
        ? item.name
        : guardianSummonsTemplatePreset.name,
    description:
      typeof item.description === "string" && item.description.trim()
        ? item.description
        : guardianSummonsTemplatePreset.description,
    sourceLabel: item.status === "PUBLISHED" ? "قالب منشور" : "قالب رسمي",
  };
}

function resolveSnippetText(block: TemplateBlock, snippets: unknown) {
  if (!Array.isArray(snippets)) return "";

  const snippetId = block.source?.snippetId;
  const title = block.title;

  const found = snippets.find((item) => {
    if (!item || typeof item !== "object") return false;

    const snippet = item as {
      id?: unknown;
      key?: unknown;
      title?: unknown;
      name?: unknown;
    };

    return (
      (snippetId && snippet.id === snippetId) ||
      (snippetId && snippet.key === snippetId) ||
      (title && snippet.title === title) ||
      (title && snippet.name === title)
    );
  }) as
    | {
        text?: unknown;
        content?: unknown;
        body?: unknown;
        value?: unknown;
      }
    | undefined;

  if (!found) return "";

  const text = found.text ?? found.content ?? found.body ?? found.value;

  return typeof text === "string" ? text.trim() : "";
}

function getValueByCanonicalKey(values: LetterValues, key: string) {
  const normalized = key.trim();

  const map: Record<string, string> = {
    studentName: values.studentName,
    studentClass: values.studentClass,
    studentNationalId: values.studentNationalId,
    guardianName: values.guardianName,
    guardianPhone: values.guardianPhone,
    summonDay: values.summonDay,
    summonsDay: values.summonDay,
    summonDate: values.summonDate,
    summonsHijriDate: values.summonDate,
    summonTime: values.summonTime,
    summonsTime: values.summonTime,
    summonPeriod: values.summonPeriod,
    summonsPeriod: values.summonPeriod,
    summonReason: values.summonReason,
    summonsReason: values.summonReason,
    notes: values.notes,
  };

  return map[normalized] || "........................";
}
