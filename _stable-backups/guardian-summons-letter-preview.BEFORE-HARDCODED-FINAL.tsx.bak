export function GuardianSummonsLetterPreview({
  template,
  previewCaseData,
  snippets,
  pdfMode = false,
  showDynamicFields = false,
}: GuardianSummonsLetterPreviewProps) {
  const data = previewCaseData || guardianSummonsPreviewCaseData;
  const templateInfo = normalizeTemplateInfo(template);
  const blocks = getTemplateBlocks(template);
  const values = buildLetterValues(data);

  return (
    <div
      dir="rtl"
      className={
        pdfMode
          ? "bg-white"
          : "rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm"
      }
    >
      {!pdfMode ? (
        <section className="mb-5 space-y-4">
          <div className="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p className="text-xs font-black text-emerald-700">
                {templateInfo.sourceLabel}
              </p>

              <h2 className="mt-1 text-2xl font-black text-slate-900">
                {templateInfo.name}
              </h2>

              <p className="mt-2 max-w-3xl text-sm leading-7 text-slate-500">
                الترويسة ثابتة، وكل ما تحتها يتحكم فيه القالب من البلوكات ومكتبة
                النصوص.
              </p>
            </div>

            <span className="rounded-full bg-emerald-50 px-4 py-2 text-xs font-black text-emerald-700">
              {blocks.length} بلوك تحت الترويسة
            </span>
          </div>

          {showDynamicFields ? <DynamicFieldsPanel /> : null}
        </section>
      ) : null}

      <article
        className={[
          "pdf-report-page mx-auto bg-white text-slate-950",
          pdfMode
            ? "min-h-[297mm] w-[210mm] px-[17mm] py-[11mm]"
            : "min-h-[297mm] w-full max-w-[210mm] rounded-[1.5rem] border border-slate-100 px-[17mm] py-[11mm]",
        ].join(" ")}
        style={{ fontFamily: "Arial, Tahoma, sans-serif" }}
      >
        <FixedOfficialHeader />

        {blocks.length ? (
          blocks.map((block, index) => (
            <BlockRenderer
              key={block.id || `${block.kind}-${index}`}
              block={withDefaultSource(block)}
              values={values}
              snippets={snippets}
              index={index}
            />
          ))
        ) : (
          <div className="mt-10 rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-5 py-8 text-center text-sm font-bold text-slate-400">
            لا توجد بلوكات أسفل الترويسة.
          </div>
        )}
      </article>
    </div>
  );
}

function FixedOfficialHeader() {
  return (
    <>
      <div className="text-center text-[14px] font-black">
        بسم الله الرحمن الرحيم
      </div>

      <table className="mt-4 w-full table-fixed border-collapse">
        <tbody>
          <tr>
            <td className="w-1/3 align-top">
              <div className="text-right text-[12px] font-bold leading-7">
                <div>المملكة العربية السعودية</div>
                <div>وزارة التعليم</div>
                <div>الإدارة العامة للتعليم بمنطقة ................</div>
                <div>مكتب التعليم بمحافظة ................</div>
              </div>
            </td>

            <td className="w-1/3 align-top">
              <div className="flex flex-col items-center justify-start text-center">
                <MinistryLogoMark />

                <div className="mt-1 text-[12px] font-black text-emerald-700">
                  وزارة التعليم
                </div>

                <div className="text-[11px] font-bold text-slate-500">
                  Ministry of Education
                </div>
              </div>
            </td>

            <td className="w-1/3 align-top">
              <div className="text-left text-[12px] font-bold leading-7">
                <div>مدرسة ........................</div>
                <div>١٤٤٠ هـ / ١٤٣٩ هـ</div>
                <div>الإرشاد الطلابي</div>
              </div>
            </td>
          </tr>
        </tbody>
      </table>

      <div className="mx-auto mt-6 h-[1px] w-full bg-slate-200" />
    </>
