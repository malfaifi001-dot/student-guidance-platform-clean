export function GuardianSummonsLetterPreview({
  template,
  previewCaseData,
  pdfMode = false,
  showDynamicFields = false,
}: GuardianSummonsLetterPreviewProps) {
  const data = previewCaseData || guardianSummonsPreviewCaseData;
  const values = buildLetterValues(data);
  const templateInfo = normalizeTemplateInfo(template);

  return (
    <div
      dir="rtl"
      className={
        pdfMode
          ? "bg-white"
          : "rounded-[2rem] border border-slate-200 bg-white p-5 shadow-sm"
      }
    >
      {!pdfMode ? (
        <section className="mb-5 space-y-4">
          <div className="flex flex-wrap items-start justify-between gap-4">
            <div>
              <p className="text-xs font-black text-emerald-700">
                {templateInfo.sourceLabel}
              </p>

              <h2 className="mt-1 text-2xl font-black text-slate-900">
                {templateInfo.name}
              </h2>

              <p className="mt-2 max-w-3xl text-sm leading-7 text-slate-500">
                تصميم رسمي ثابت مطابق لنموذج الاستدعاء، مع متغيرات ديناميكية
                لبيانات الطالب وولي الأمر وموعد الحضور وسبب الاستدعاء.
              </p>
            </div>

            <span className="rounded-full bg-emerald-50 px-4 py-2 text-xs font-black text-emerald-700">
              Hardcoded رسمي
            </span>
          </div>

          {showDynamicFields ? <DynamicFieldsPanel /> : null}
        </section>
      ) : null}

      <article
        className={[
          "pdf-report-page mx-auto bg-white text-black",
          pdfMode
            ? "min-h-[297mm] w-[210mm] px-[17mm] py-[10mm]"
            : "min-h-[297mm] w-full max-w-[210mm] rounded-[1.5rem] border border-slate-100 px-[17mm] py-[10mm]",
        ].join(" ")}
        style={{
          fontFamily: "Arial, Tahoma, sans-serif",
        }}
      >
        <OfficialHeader values={values} />

        <h1 className="mt-6 text-center text-[28px] font-black tracking-tight">
          استدعاء ولي أمر طالب
        </h1>

        <section className="mt-7 text-[15px] font-bold leading-9">
          <table className="w-full table-fixed border-collapse">
            <tbody>
              <tr>
                <td className="w-[40mm] whitespace-nowrap text-right">
                  المكرم ولي أمر الطالب /
                </td>

                <td className="border-b border-dotted border-black px-2 text-center font-black">
                  {values.guardianName}
                </td>

                <td className="w-[14mm] whitespace-nowrap text-center">
                  بالصف
                </td>

                <td className="w-[44mm] border-b border-dotted border-black px-2 text-center font-black">
                  {values.studentClass}
                </td>

                <td className="w-[22mm] whitespace-nowrap text-left">
                  سلمه الله
                </td>
              </tr>
            </tbody>
          </table>
        </section>

        <section className="mt-7 text-center text-[15px] font-bold leading-9">
          السلام عليكم ورحمة الله وبركاته ،،،
        </section>

        <section className="mx-auto mt-5 max-w-[170mm] text-center text-[15px] font-semibold leading-[2.15]">
          نظرًا لأهمية التعاون المستمر والتنسيق بين المدرسة وولي أمر الطالب فيما
          يخدم مصلحته ويحقق له النجاح بإذن الله.
        </section>

        <section className="mt-7 text-[14px] font-bold leading-8">
          <table className="w-full table-fixed border-collapse">
            <tbody>
              <tr>
                <td className="w-[45mm] whitespace-nowrap text-right">
                  لذا نأمل منكم الحضور
                </td>

                <td className="w-[10mm] whitespace-nowrap text-center">
                  يوم
                </td>

                <td className="w-[30mm] border-b border-dotted border-black px-2 text-center font-black">
                  {values.summonDay}
                </td>

                <td className="w-[20mm] whitespace-nowrap text-center">
                  الموافق
                </td>

                <td className="border-b border-dotted border-black px-2 text-center font-black">
                  {values.summonDate}
                </td>

                <td className="w-[18mm] whitespace-nowrap text-center">
                  الساعة
                </td>

                <td className="w-[28mm] border-b border-dotted border-black px-2 text-center font-black">
                  {values.summonTime}
                </td>

                <td className="w-[26mm] border-b border-dotted border-black px-2 text-center font-black">
                  {values.summonPeriod}
                </td>
