function MinistryLogoMark() {
  return (
    <div className="relative h-[38px] w-[92px]" aria-hidden="true">
      <span className="absolute left-[8px] top-[10px] h-[7px] w-[7px] rounded-full bg-sky-500" />
      <span className="absolute left-[22px] top-[5px] h-[7px] w-[7px] rounded-full bg-emerald-500" />
      <span className="absolute left-[36px] top-[10px] h-[7px] w-[7px] rounded-full bg-sky-500" />
      <span className="absolute left-[50px] top-[5px] h-[7px] w-[7px] rounded-full bg-emerald-500" />
      <span className="absolute left-[64px] top-[10px] h-[7px] w-[7px] rounded-full bg-sky-500" />
      <span className="absolute left-[78px] top-[5px] h-[7px] w-[7px] rounded-full bg-emerald-500" />

      <span className="absolute left-[15px] top-[22px] h-[7px] w-[7px] rounded-full bg-emerald-500" />
      <span className="absolute left-[31px] top-[24px] h-[7px] w-[7px] rounded-full bg-sky-500" />
      <span className="absolute left-[47px] top-[22px] h-[7px] w-[7px] rounded-full bg-emerald-500" />
      <span className="absolute left-[63px] top-[24px] h-[7px] w-[7px] rounded-full bg-sky-500" />
    </div>
  );
}

function getValue(data: RuntimePreviewCaseData, keys: string[]) {
  const values = Array.isArray(data.values)
    ? (data.values as PreviewValue[])
    : [];

  for (const key of keys) {
    const item = values.find((value) => value.fieldKey === key);

    if (item?.value !== undefined && item.value !== null && String(item.value).trim()) {
      return String(item.value).trim();
    }
  }

  return "";
}

function splitReasons(value: string) {
  const reasons = value
    .split(/\n|،|;|؛/)
    .map((item) => item.trim())
    .filter(Boolean);

  return reasons.length ? reasons : [value];
}
