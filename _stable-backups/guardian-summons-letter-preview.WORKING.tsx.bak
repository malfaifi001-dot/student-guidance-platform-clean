              <div>١٤٤٠ هـ / ١٤٣٩ هـ</div>
              <div>الإرشاد الطلابي</div>
            </div>
          </header>

          <h1 className="mt-7 text-center text-[24px] font-black tracking-tight">
            استدعاء ولي أمر طالب
