              <h2 className="text-2xl font-black text-slate-900">
                معاينة خطاب استدعاء ولي أمر
              </h2>
              <p className="mt-2 text-sm leading-7 text-slate-500">
                هذه معاينة رسمية للخطاب كما سيظهر عند التصدير PDF.
              </p>
            </div>
            <span className="rounded-full bg-emerald-50 px-4 py-2 text-xs font-black text-emerald-700">
              قالب رسمي
            </span>
          </div>
        </section>
      ) : null}

      <article
        className={[
          "pdf-report-page mx-auto bg-white text-slate-950",
          pdfMode ? "" : "rounded-[1.5rem] border border-slate-100 shadow-sm",
