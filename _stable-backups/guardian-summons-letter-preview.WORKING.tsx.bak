              <span>الموافق</span>

              <span className="inline-flex items-center gap-2">
                <span>)</span>
                <span className="min-w-[32mm] text-center font-black">
                  {summonDate}
                </span>
                <span>(</span>
              </span>

              <span>الساعة</span>

              <span className="inline-flex items-center gap-2">
                <span>)</span>
                <span className="min-w-[18mm] text-center font-black">
                  {summonTime}
                </span>
