<tr><td>الخامس عشر</td><td>26/6–1/7</td><td>المجلس الطلابي والعمل التطوعي</td><td>مبادرات ومشاركة</td></tr>
<tr><td>السادس عشر</td><td>4–8/7</td><td>التوجيه التعليمي والمهني</td><td>وعي بالميول والمسارات</td></tr>
<tr><td>السابع عشر</td><td>11–15/7</td><td>مهارات الاستذكار وإدارة الوقت</td><td>خطة مراجعة ودعم</td></tr>
<tr><td>الثامن عشر</td><td>18–22/7</td><td>التهيئة النهائية للاختبارات</td><td>جاهزية مباشرة</td></tr>
<tr><td>التاسع عشر</td><td>25–29/7</td><td>المساندة أثناء الاختبارات وإغلاق الفصل</td><td>دعم وتقرير ختامي</td></tr>
</table>
