<tr><td>أسبوع العودة</td><td>3–7/3/1448هـ</td><td>التعارف والاستعداد وتشكيل اللجان</td><td>جاهزية العمل وبداية العام</td></tr>
<tr><td>الأول</td><td>10–14/3</td><td>الأسبوع التمهيدي والتهيئة الإرشادية</td><td>تكيف أولي وحصر مبكر</td></tr>
<tr><td>الثاني</td><td>17–21/3</td><td>حصر الاحتياجات وخصائص النمو</td><td>إحالات مصنفة وأولوية واضحة</td></tr>
<tr><td>الثالث</td><td>24–28/3</td><td>قائمة المشكلات الطلابية ودراسة الحالات</td><td>خطط متابعة أولية</td></tr>
<tr><td>الرابع</td><td>2–6/4</td><td>تعزيز السلوك الإيجابي</td><td>قيمة مفعلة وتعزيز موثق</td></tr>
<tr><td>الخامس</td><td>9–13/4</td><td>القيم والمواطنة والانتماء</td><td>نشاط وطني وقيمي</td></tr>
<tr><td>السادس</td><td>16–20/4</td><td>الاستخدام الآمن للإنترنت</td><td>وعي رقمي للطلبة والأسر</td></tr>
<tr><td>السابع</td><td>23–27/4</td><td>التهيئة الإرشادية للاختبارات</td><td>جاهزية ودعم للقلق</td></tr>
<tr><td>الثامن</td><td>30/4–4/5</td><td>رعاية المتأخرين والمتفوقين</td><td>تحليل ودعم وتكريم</td></tr>
<tr><td>التاسع</td><td>7–11/5</td><td>المهارات النفسية والاجتماعية</td><td>مهارات ومتابعة حالات</td></tr>
<tr><td>العاشر</td><td>14–18/5</td><td>خفض العنف والحد من التنمر</td><td>وعي وقنوات إبلاغ</td></tr>
<tr><td>الحادي عشر</td><td>21–25/5</td><td>تنمية الدافعية لرفع التحصيل</td><td>خطط تحفيز ومتابعة</td></tr>
<tr><td>الثاني عشر</td><td>28/5–2/6</td><td>تحليل النتائج والخطط العلاجية</td><td>مقارنة وتحديث وتكريم</td></tr>
<tr><td>الثالث عشر</td><td>5–9/6</td><td>الصحة النفسية والصحية والتسامح</td><td>توعية ومراجعة الحالات</td></tr>
<tr><td>إجازة الخريف</td><td>12–16/6</td><td>إجازة رسمية</td><td>—</td></tr>
