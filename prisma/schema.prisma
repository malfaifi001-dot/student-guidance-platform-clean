generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  COUNSELOR
  ACTIVITY_LEADER
  TEACHER
  PRINCIPAL
  SCHOOL_OWNER
  STAFF
}

enum PushCampaignType {
  MANUAL
  SCHEDULED
  RECURRING
  AUTOMATIC
  SYSTEM_TEST
}

enum PushCampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  SENT
  PARTIALLY_FAILED
  FAILED
  CANCELED
}

enum PushAudienceType {
  ALL_USERS
  ROLE
  USER
  USERS
  SCHOOL
}

enum PushDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PushRecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  WEEKDAYS
}

enum GuidanceVideoSourceType {
  UPLOAD
  YOUTUBE
}

enum ReferenceLibraryItemType {
  FOLDER
  FILE
}

enum ReferenceLibraryItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReferenceLibraryAudienceType {
  ALL_USERS
  ROLE
  USER
}

enum ImportSessionStatus {
  DRAFT
  PARSED
  COMMITTED
  FAILED
  CANCELED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  CREATED
  UPDATED
  SKIPPED
  CONFLICT
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum SalesExperienceMode {
  SERVICE
  BAG
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum StudentPickerMode {
  SERVICE_DEFAULT
  REQUIRED
  DISABLED
}

enum WorkflowEvidenceMode {
  SERVICE_DEFAULT
  ENABLED
  DISABLED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  FILE_UPLOAD
  IMAGE_UPLOAD
  STUDENT_PICKER
  PARENT_PICKER
  STAFF_PICKER
  REPEATER
  SIGNATURE
  RICH_TEXT
}

enum ActivityAssignmentStatus {
  SENT
  OPENED
  SUBMITTED
  APPROVED
  RETURNED
  EXPIRED
  CANCELED
}

enum InternalAssignmentStatus {
  PENDING
  OPENED
  SUBMITTED
  COMPLETED
  CANCELED
}

enum InternalAssignmentReportType {
  GUIDANCE_REPORT
  REPORT_SNAPSHOT
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum EvidenceType {
  IMAGE
  FILE
  LINK
}

enum CalendarReminderStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum CalendarReminderPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum CalendarReminderLinkType {
  GENERAL
  SERVICE
  CASE
  STUDENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  MANUAL
}

enum OperationalExpenseStatus {
  DUE
  PAID
  OVERDUE
  CANCELED
}

enum ExpensePaymentMethod {
  BANK_TRANSFER
  CARD
  CASH
  WALLET
  DIRECT_DEBIT
  OTHER
}

enum ExpensePaymentSourceType {
  BANK_ACCOUNT
  CARD
  CASH
  WALLET
  OTHER
}

enum ExpenseRecurrenceInterval {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SurveyQuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  RATING
  SCALE
  NUMBER
  DATE
}

model SchoolAccount {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  isActive              Boolean                @default(true)
  studentImportSessions StudentImportSession[]
  users                 User[]

  profile                      SchoolProfile?
  activityTeam                 SchoolActivityTeam?
  students                     Student[]
  guardians                    Guardian[]
  staff                        StaffMember[]
  services                     ServiceAccess[]
  cases                        CaseEntry[]
  subscription                 Subscription?
  resultsAnalyses              ResultsAnalysis[]
  assessmentAnalyses           AssessmentAnalysis[]
  calendarReminders            CalendarReminder[]
  activityAssignments          ActivityAssignment[]           @relation("ActivityAssignmentsBySchool")
  internalAssignments          InternalAssignment[]           @relation("InternalAssignmentsBySchool")
  surveys                      Survey[]                       @relation("SurveysBySchool")
  surveyResponses              SurveyResponse[]               @relation("SurveyResponsesBySchool")
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  achievementPortfolios        AchievementPortfolio[]
  portfolioSnapshots           PortfolioSnapshot[]
  referenceLibraryItems        ReferenceLibraryItem[]         @relation("ReferenceLibrarySchool")
  timetableProjects            TimetableProject[]
  timetableProjectHistory      TimetableProjectHistoryEntry[]
  timetableDailyAbsences       TimetableDailyAbsence[]
  timetableSubstitutions       TimetableSubstitution[]
  timetableSupervisionDuties   TimetableSupervisionDuty[]
  timetableSubjectBank         TimetableSubjectBankEntry[]
  timetableCurriculumTemplates TimetableCurriculumTemplate[]
  couponRedemptions            CouponRedemption[]
  reportSignatureRequests      ReportSignatureRequest[]
  activityPlanEntries          ActivityPlanEntry[]
  activityPlanShareTokens      ActivityPlanShareToken[]
  savedCurriculumSubjects      TeacherSavedCurriculum[]
}

// Imported, platform-owned curriculum catalog. This data is not school-scoped.
model CurriculumStage {
  id        String            @id @default(cuid())
  sourceKey String            @unique @db.VarChar(191)
  name      String
  parentId  String?
  parent    CurriculumStage?  @relation("CurriculumStageHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  CurriculumStage[] @relation("CurriculumStageHierarchy")
  sortOrder Int               @default(0)
  tracks    CurriculumTrack[]
  grades    CurriculumGrade[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([name])
  @@index([parentId, sortOrder])
}

model CurriculumTrack {
  id        String            @id @default(cuid())
  sourceKey String            @unique @db.VarChar(191)
  name      String
  stageId   String
  stage     CurriculumStage   @relation(fields: [stageId], references: [id], onDelete: Cascade)
  grades    CurriculumGrade[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([stageId, name])
  @@index([stageId])
}

model CurriculumGrade {
  id        String               @id @default(cuid())
  sourceKey String               @unique @db.VarChar(191)
  name      String
  stageId   String
  stage     CurriculumStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  trackId   String?
  track     CurriculumTrack?     @relation(fields: [trackId], references: [id], onDelete: Cascade)
  semesters CurriculumSemester[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@unique([stageId, trackId, name])
  @@index([stageId, trackId])
}

model CurriculumSemester {
  id        String              @id @default(cuid())
  sourceKey String              @unique @db.VarChar(191)
  name      String
  gradeId   String
  grade     CurriculumGrade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subjects  CurriculumSubject[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([gradeId, name])
  @@index([gradeId])
}

model CurriculumSubject {
  id         String             @id @default(cuid())
  sourceKey  String             @unique @db.VarChar(191)
  name       String
  isExtra    Boolean            @default(false)
  semesterId String
  semester   CurriculumSemester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  weeks      CurriculumWeek[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([semesterId, name])
  @@index([semesterId])
}

model CurriculumWeek {
  id        String             @id @default(cuid())
  sourceKey String             @unique @db.VarChar(191)
  sequence  Int
  subjectId String
  subject   CurriculumSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  lessons   CurriculumLesson[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([subjectId, sequence])
  @@index([subjectId, sequence])
}

model CurriculumLesson {
  id        String         @id @default(cuid())
  sourceKey String         @unique @db.VarChar(191)
  text      String         @db.Text
  unit      String?
  lesson    String?
  weekId    String
  week      CurriculumWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([weekId])
}

model User {
  id              String         @id @default(cuid())
  schoolAccountId String?
  schoolAccount   SchoolAccount? @relation(fields: [schoolAccountId], references: [id])

  name              String
  email             String    @unique
  phone             String?
  passwordHash      String?
  role              UserRole  @default(COUNSELOR)
  gender            Gender    @default(UNKNOWN)
  officialName      String?
  jobTitle          String?
  signatureUrl      String?   @db.Text
  signatureSignedAt DateTime?

  teachingStages      Json?
  teachingSpecialties Json?
  teachingSubjects    Json?
  isActive            Boolean @default(true)

  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  cases                       CaseEntry[]
  sessions                    UserSession[]
  pushDevices                 PushDevice[]
  pushCampaignsCreated        PushCampaign[]       @relation("PushCampaignCreator")
  pushTemplatesCreated        PushTemplate[]       @relation("PushTemplateCreator")
  whatsappMessageTemplates    WhatsAppMessageTemplate[] @relation("WhatsAppMessageTemplateCreator")
  pushAutomaticRulesCreated   PushAutomaticRule[]  @relation("PushAutomaticRuleCreator")
  pushDeliveries              PushDelivery[]
  calendarReminders           CalendarReminder[]
  createdActivityAssignments  ActivityAssignment[] @relation("ActivityAssignmentsCreatedBy")
  createdInternalAssignments  InternalAssignment[] @relation("InternalAssignmentsCreatedBy")
  receivedInternalAssignments InternalAssignment[] @relation("InternalAssignmentsAssignedTo")
  createdSurveys              Survey[]             @relation("SurveysCreatedBy")
  activityPlanEntries         ActivityPlanEntry[]

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  caseEvidences                 CaseEvidence[]
  createdReportTemplates        ReportTemplate[]
  achievementPortfolios         AchievementPortfolio[]         @relation("AchievementPortfolioOwner")
  portfolioSnapshots            PortfolioSnapshot[]            @relation("PortfolioSnapshotOwner")
  createdReferenceLibraryItems  ReferenceLibraryItem[]         @relation("ReferenceLibraryCreatedBy")
  referenceLibraryAudienceRules ReferenceLibraryAudience[]     @relation("ReferenceLibraryAudienceUser")
  createdGuidanceVideos         GuidanceVideo[]                @relation("GuidanceVideoCreatedBy")
  createdTimetableProjects      TimetableProject[]             @relation("TimetableProjectCreator")
  timetableHistoryEntries       TimetableProjectHistoryEntry[] @relation("TimetableHistoryActor")
  timetableHistoryReversions    TimetableProjectHistoryEntry[] @relation("TimetableHistoryReverter")
  timetableTeacherProfiles      TimetableTeacher[]
  serviceOutputLinks            ServiceOutputLink[]
  reportSignatureRequests       ReportSignatureRequest[]
  activityPlanShareTokens       ActivityPlanShareToken[]
  savedCurriculumSubjects       TeacherSavedCurriculum[]
  salesExperienceOverride       SalesExperienceUserOverride?

  @@index([schoolAccountId])
}

model ServiceOutputLink {
  id                  String   @id @default(cuid())
  schoolAccountId     String?
  ownerUserId         String
  owner               User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  roleKey             String   @db.VarChar(40)
  serviceSlug         String   @db.VarChar(120)
  performanceItemKey  String   @db.VarChar(180)
  targetSectionKey    String?  @db.VarChar(180)
  resourceType        String   @db.VarChar(80)
  sourceKey           String   @db.VarChar(255)
  sourceReferenceJson Json
  displayTitle        String   @db.VarChar(255)
  metadataJson        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([ownerUserId, roleKey, performanceItemKey, serviceSlug, resourceType, sourceKey], map: "ServiceOutputLink_owner_scope_source_key")
  @@index([ownerUserId, roleKey, performanceItemKey], map: "ServiceOutputLink_owner_performance_idx")
  @@index([schoolAccountId, serviceSlug], map: "ServiceOutputLink_school_service_idx")
  @@index([ownerUserId, roleKey, targetSectionKey], map: "ServiceOutputLink_owner_section_idx")
}

model ActivityPlanShareToken {
  id              String        @id @default(cuid())
  tokenHash       String        @unique @db.VarChar(64)
  encryptedToken  String        @db.Text
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  revokedAt       DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([schoolAccountId, revokedAt])
  @@index([createdById])
}

model TeacherSavedCurriculum {
  id              String        @id @default(cuid())
  ownerUserId     String
  owner           User          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)
  serviceSlug     String        @default("curriculum-distribution") @db.VarChar(120)
  resourceType    String        @default("CURRICULUM_DISTRIBUTION") @db.VarChar(80)
  subjectId       String        @db.VarChar(191)
  semesterId      String        @db.VarChar(191)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([ownerUserId, subjectId, semesterId], map: "TeacherSavedCurriculum_owner_subject_semester_uq")
  @@index([schoolAccountId, ownerUserId, sortOrder])
}

model GuidanceVideo {
  id String @id @default(cuid())

  title       String  @db.VarChar(200)
  description String? @db.Text

  sourceType       GuidanceVideoSourceType @default(UPLOAD)
  storageKey       String?                 @unique @db.VarChar(255)
  originalFileName String?                 @db.VarChar(255)
  mimeType         String?                 @db.VarChar(100)
  sizeBytes        Int?
  youtubeVideoId   String?                 @db.VarChar(32)

  targetRoles Json
  isPublished Boolean @default(false)
  sortOrder   Int     @default(0)

  createdById String?
  createdBy   User?   @relation("GuidanceVideoCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@index([createdById])
  @@index([createdAt])
  @@index([sourceType])
}

model UserSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId String @unique

  userAgent String?
  ipAddress String?

  isActive   Boolean   @default(true)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenId])
  @@index([isActive])
  @@index([expiresAt])
}

model PushDevice {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String         @unique @db.VarChar(64)
  encryptedToken String         @db.Text
  platform       String         @db.VarChar(20)
  packageName    String         @db.VarChar(100)
  enabled        Boolean        @default(true)
  revokedAt      DateTime?
  lastSeenAt     DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deliveries     PushDelivery[]

  @@index([userId, enabled])
  @@index([userId, platform, packageName])
}

model PushCampaign {
  id                   String                   @id @default(cuid())
  name                 String?
  title                String                   @db.VarChar(120)
  body                 String                   @db.Text
  route                String                   @db.VarChar(255)
  type                 PushCampaignType
  status               PushCampaignStatus       @default(DRAFT)
  audienceType         PushAudienceType
  audienceConfig       Json
  internalNote         String?                  @db.Text
  scheduledAt          DateTime?
  timezone             String?                  @db.VarChar(80)
  recurrenceFrequency  PushRecurrenceFrequency?
  recurrenceDays       Json?
  recurrenceEndAt      DateTime?
  recurrenceActive     Boolean                  @default(false)
  startedAt            DateTime?
  completedAt          DateTime?
  canceledAt           DateTime?
  processingStartedAt  DateTime?
  estimatedUserCount   Int                      @default(0)
  estimatedDeviceCount Int                      @default(0)
  sentCount            Int                      @default(0)
  successCount         Int                      @default(0)
  failureCount         Int                      @default(0)
  openedCount          Int                      @default(0)
  lastErrorCode        String?                  @db.VarChar(120)
  createdById          String
  createdBy            User                     @relation("PushCampaignCreator", fields: [createdById], references: [id])
  deliveries           PushDelivery[]
  automaticEvent       PushAutomaticEvent?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([status, scheduledAt])
  @@index([type, createdAt])
  @@index([createdById, createdAt])
}

model PushDelivery {
  id                String             @id @default(cuid())
  campaignId        String
  campaign          PushCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId          String
  device            PushDevice         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  status            PushDeliveryStatus @default(PENDING)
  provider          String?            @db.VarChar(40)
  attemptCount      Int                @default(0)
  attemptedAt       DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  firebaseMessageId String?            @db.VarChar(255)
  errorCode         String?            @db.VarChar(120)
  errorCategory     String?            @db.VarChar(40)
  safeErrorMessage  String?            @db.Text
  retryable         Boolean            @default(false)
  invalidToken      Boolean            @default(false)
  openedAt          DateTime?
  openedRoute       String?            @db.VarChar(255)
  retryCount        Int                @default(0)
  lastRetryAt       DateTime?
  nextRetryAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([campaignId, deviceId])
  @@index([campaignId, status])
  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

model PushAutomaticRule {
  id              String               @id @default(cuid())
  triggerKey      String               @unique @db.VarChar(120)
  name            String               @db.VarChar(160)
  description     String?              @db.Text
  enabled         Boolean              @default(false)
  audienceType    PushAudienceType
  audienceConfig  Json
  titleTemplate   String               @db.VarChar(120)
  bodyTemplate    String               @db.Text
  route           String               @db.VarChar(255)
  lastTriggeredAt DateTime?
  totalSends      Int                  @default(0)
  lastResult      String?              @db.VarChar(120)
  lastErrorCode   String?              @db.VarChar(120)
  createdById     String?
  createdBy       User?                @relation("PushAutomaticRuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  events          PushAutomaticEvent[]

  @@index([enabled, triggerKey])
}

model PushTemplate {
  id          String           @id @default(cuid())
  name        String           @unique @db.VarChar(160)
  title       String           @db.VarChar(120)
  body        String           @db.Text
  route       String           @db.VarChar(255)
  type        PushCampaignType @default(MANUAL)
  category    String?          @db.VarChar(80)
  enabled     Boolean          @default(true)
  createdById String
  createdBy   User             @relation("PushTemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([enabled, createdAt])
}

model WhatsAppMessageTemplate {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(160)
  content     String   @db.Text
  coupon      String?  @db.VarChar(160)
  isActive    Boolean  @default(false)
  createdById String?
  createdBy   User?    @relation("WhatsAppMessageTemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([createdAt])
  @@index([createdById])
}

model PushAutomaticEvent {
  id         String            @id @default(cuid())
  ruleId     String
  rule       PushAutomaticRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  eventKey   String            @unique @db.VarChar(191)
  campaignId String?           @unique
  campaign   PushCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt  DateTime          @default(now())

  @@index([ruleId, createdAt])
}

model SchoolProfile {
  id              String        @id @default(cuid())
  schoolAccountId String        @unique
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  schoolName                    String
  principalName                 String?
  principalPhone                String?
  principalSignatureUrl         String?
  principalSignatureToken       String?   @unique
  principalSignatureRequestedAt DateTime?
  principalSignatureSignedAt    DateTime?

  activityLeaderName         String?
  activityLeaderSignatureUrl String?
  activityLeaderSignedAt     DateTime?

  counselorSignatureUrl String?
  counselorSignedAt     DateTime?

  educationDepartment     String?
  educationOffice         String?
  schoolStatisticalNumber String? @db.VarChar(50)
  city                    String?
  district                String?
  stage                   String?
  academicYear            String?
  currentSemester         String?
  logoUrl                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SchoolActivityTeam {
  id              String        @id @default(cuid())
  schoolAccountId String        @unique
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)
  assignments     Json
  supervisorSignatures SchoolActivityTeamSupervisorSignature[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([schoolAccountId])
}

model SchoolActivityTeamSupervisorSignature {
  id             String           @id @default(cuid())
  activityTeamId String
  activityTeam   SchoolActivityTeam @relation(fields: [activityTeamId], references: [id], onDelete: Cascade)
  supervisorName String           @db.VarChar(160)
  fieldKeys      Json
  signatureUrl   String           @db.Text
  signedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([activityTeamId, supervisorName], map: "ActivityTeamSign_uq")
  @@index([activityTeamId, signedAt], map: "ATS_time_idx")
}

model Guardian {
  id              String        @id @default(cuid())
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  name     String
  phone    String?
  relation String?

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
}

model Student {
  id              String        @id @default(cuid())
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id])

  fullName   String
  nationalId String?
  gender     Gender  @default(UNKNOWN)
  stage      String?
  grade      String?
  classroom  String?
  phone      String?
  isActive   Boolean @default(true)

  cases             CaseEntry[]
  calendarReminders CalendarReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
  @@index([guardianId])
  @@index([fullName])
}

model StaffMember {
  id              String        @id @default(cuid())
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  name      String
  roleTitle String?
  phone     String?
  email     String?
  gender    Gender  @default(UNKNOWN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
}

model ReferenceLibraryItem {
  id String @id @default(cuid())

  parentId String?
  parent   ReferenceLibraryItem?  @relation("ReferenceLibraryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children ReferenceLibraryItem[] @relation("ReferenceLibraryHierarchy")

  schoolAccountId String?
