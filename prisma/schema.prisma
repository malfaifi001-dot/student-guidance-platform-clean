generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  COUNSELOR
  ACTIVITY_LEADER
  TEACHER
  SCHOOL_OWNER
  STAFF
}

enum ReferenceLibraryItemType {
  FOLDER
  FILE
}

enum ReferenceLibraryItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReferenceLibraryAudienceType {
  ALL_USERS
  ROLE
  USER
}

enum ImportSessionStatus {
  DRAFT
  PARSED
  COMMITTED
  FAILED
  CANCELED
}

enum ImportRowStatus {
  PENDING
  VALID
  INVALID
  CREATED
  UPDATED
  SKIPPED
  CONFLICT
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
  COMING_SOON
}

enum StudentPickerMode {
  SERVICE_DEFAULT
  REQUIRED
  DISABLED
}

enum WorkflowEvidenceMode {
  SERVICE_DEFAULT
  ENABLED
  DISABLED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
  RADIO
  FILE_UPLOAD
  IMAGE_UPLOAD
  STUDENT_PICKER
  PARENT_PICKER
  STAFF_PICKER
  REPEATER
  SIGNATURE
  RICH_TEXT
}

enum ActivityAssignmentStatus {
  SENT
  OPENED
  SUBMITTED
  APPROVED
  RETURNED
  EXPIRED
  CANCELED
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  ARCHIVED
}

enum EvidenceType {
  IMAGE
  FILE
  LINK
}

enum CalendarReminderStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum CalendarReminderPriority {
  NORMAL
  IMPORTANT
  URGENT
}

enum CalendarReminderLinkType {
  GENERAL
  SERVICE
  CASE
  STUDENT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  MANUAL
}

enum IntegrationStatus {
  ACTIVE
  INACTIVE
  ERROR
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SurveyQuestionType {
  TEXT
  TEXTAREA
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  YES_NO
  RATING
  SCALE
  NUMBER
  DATE
}

model SchoolAccount {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  isActive              Boolean                @default(true)
  studentImportSessions StudentImportSession[]
  users                 User[]

  profile               SchoolProfile?
  students              Student[]
  guardians             Guardian[]
  staff                 StaffMember[]
  services              ServiceAccess[]
  cases                 CaseEntry[]
  subscription          Subscription?
  resultsAnalyses       ResultsAnalysis[]
  assessmentAnalyses    AssessmentAnalysis[]
  calendarReminders     CalendarReminder[]
  activityAssignments   ActivityAssignment[]   @relation("ActivityAssignmentsBySchool")
  surveys               Survey[]               @relation("SurveysBySchool")
  surveyResponses       SurveyResponse[]       @relation("SurveyResponsesBySchool")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  achievementPortfolios AchievementPortfolio[]
  referenceLibraryItems ReferenceLibraryItem[] @relation("ReferenceLibrarySchool")
}

model User {
  id              String         @id @default(cuid())
  schoolAccountId String?
  schoolAccount   SchoolAccount? @relation(fields: [schoolAccountId], references: [id])

  name              String
  email             String    @unique
  phone             String?
  passwordHash      String?
  role              UserRole  @default(COUNSELOR)
  gender            Gender    @default(UNKNOWN)
  officialName      String?
  jobTitle          String?
  signatureUrl      String?   @db.Text
  signatureSignedAt DateTime?

  teachingStages      Json?
  teachingSpecialties Json?
  teachingSubjects    Json?
  isActive            Boolean @default(true)

  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  cases                      CaseEntry[]
  sessions                   UserSession[]
  calendarReminders          CalendarReminder[]
  createdActivityAssignments ActivityAssignment[] @relation("ActivityAssignmentsCreatedBy")
  createdSurveys             Survey[]             @relation("SurveysCreatedBy")

  createdAt                     DateTime                   @default(now())
  updatedAt                     DateTime                   @updatedAt
  caseEvidences                 CaseEvidence[]
  createdReportTemplates        ReportTemplate[]
  achievementPortfolios         AchievementPortfolio[]     @relation("AchievementPortfolioOwner")
  createdReferenceLibraryItems  ReferenceLibraryItem[]     @relation("ReferenceLibraryCreatedBy")
  referenceLibraryAudienceRules ReferenceLibraryAudience[] @relation("ReferenceLibraryAudienceUser")

  @@index([schoolAccountId])
}

model UserSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId String @unique

  userAgent String?
  ipAddress String?

  isActive   Boolean   @default(true)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenId])
  @@index([isActive])
  @@index([expiresAt])
}

model SchoolProfile {
  id              String        @id @default(cuid())
  schoolAccountId String        @unique
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  schoolName                    String
  principalName                 String?
  principalPhone                String?
  principalSignatureUrl         String?
  principalSignatureToken       String?   @unique
  principalSignatureRequestedAt DateTime?
  principalSignatureSignedAt    DateTime?

  activityLeaderName         String?
  activityLeaderSignatureUrl String?
  activityLeaderSignedAt     DateTime?

  counselorSignatureUrl String?
  counselorSignedAt     DateTime?

  educationDepartment     String?
  educationOffice         String?
  schoolStatisticalNumber String? @db.VarChar(50)
  city                    String?
  district                String?
  stage                   String?
  academicYear            String?
  currentSemester         String?
  logoUrl                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Guardian {
  id              String        @id @default(cuid())
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  name     String
  phone    String?
  relation String?

  students Student[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
}

model Student {
  id              String        @id @default(cuid())
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  guardianId String?
  guardian   Guardian? @relation(fields: [guardianId], references: [id])

  fullName   String
  nationalId String?
  gender     Gender  @default(UNKNOWN)
  stage      String?
  grade      String?
  classroom  String?
  phone      String?
  isActive   Boolean @default(true)

  cases             CaseEntry[]
  calendarReminders CalendarReminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
  @@index([guardianId])
  @@index([fullName])
}

model StaffMember {
  id              String        @id @default(cuid())
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  name      String
  roleTitle String?
  phone     String?
  email     String?
  gender    Gender  @default(UNKNOWN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
}

model ReferenceLibraryItem {
  id String @id @default(cuid())

  parentId String?
  parent   ReferenceLibraryItem?  @relation("ReferenceLibraryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children ReferenceLibraryItem[] @relation("ReferenceLibraryHierarchy")

  schoolAccountId String?
  schoolAccount   SchoolAccount? @relation("ReferenceLibrarySchool", fields: [schoolAccountId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("ReferenceLibraryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  title       String  @db.VarChar(200)
  description String? @db.Text

  itemType ReferenceLibraryItemType
  status   ReferenceLibraryItemStatus @default(DRAFT)

  sortOrder     Int     @default(0)
  allowDownload Boolean @default(true)

  originalFileName   String? @db.VarChar(255)
  storageKey         String? @unique @db.VarChar(255)
  originalStorageKey String? @unique @db.VarChar(255)

  mimeType      String? @db.VarChar(150)
  fileExtension String? @db.VarChar(20)
  sizeBytes     Int?

  pdfFileName   String? @db.VarChar(255)
  pdfStorageKey String? @unique @db.VarChar(255)
  pdfMimeType   String? @db.VarChar(150)
  pdfSizeBytes  Int?

  docxFileName   String? @db.VarChar(255)
  docxStorageKey String? @unique @db.VarChar(255)
  docxMimeType   String? @db.VarChar(150)
  docxSizeBytes  Int?

  previewStorageKey  String?   @unique @db.VarChar(255)
  previewMimeType    String?   @db.VarChar(150)
  previewSizeBytes   Int?
  previewGeneratedAt DateTime?

  pdfCoverApplied Boolean @default(false)

  publishedAt DateTime?
  archivedAt  DateTime?

  audiences ReferenceLibraryAudience[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([schoolAccountId])
  @@index([createdById])
  @@index([itemType])
  @@index([status])
  @@index([sortOrder])
  @@index([createdAt])
}

model ReferenceLibraryAudience {
  id String @id @default(cuid())

  itemId String
  item   ReferenceLibraryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  audienceType ReferenceLibraryAudienceType

  userId String?
  user   User?   @relation("ReferenceLibraryAudienceUser", fields: [userId], references: [id], onDelete: Cascade)

  role UserRole?

  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([audienceType])
  @@index([userId])
  @@index([role])
}

model Service {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  status      ServiceStatus @default(ACTIVE)

  workflows           Workflow[]
  cases               CaseEntry[]
  access              ServiceAccess[]
  calendarReminders   CalendarReminder[]
  activityAssignments ActivityAssignment[] @relation("ActivityAssignmentsService")
  surveys             Survey[]             @relation("SurveysService")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  name         String
  version      Int            @default(1)
  status       WorkflowStatus @default(DRAFT)
  isActive     Boolean        @default(false)
  workflowType String         @default("default")
  activeKey    String?        @unique @db.VarChar(255)

  originalFileName       String?   @db.VarChar(255)
  originalFileStorageKey String?   @unique @db.VarChar(255)
  originalFileMimeType   String?   @db.VarChar(150)
  originalFileSize       Int?
  originalFileUploadedAt DateTime?

  studentPickerMode   StudentPickerMode    @default(SERVICE_DEFAULT)
  evidenceMode        WorkflowEvidenceMode @default(SERVICE_DEFAULT)
  steps               WorkflowStep[]
  cases               CaseEntry[]
  activityAssignments ActivityAssignment[] @relation("ActivityAssignmentsWorkflow")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceId])
  @@index([serviceId, workflowType, isActive])
}

model WorkflowStep {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  title       String
  description String?
  order       Int

  fields DynamicField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId])
  @@index([order])
}

model DynamicField {
  id     String       @id @default(cuid())
  stepId String
  step   WorkflowStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  key         String
  label       String    @db.Text
  type        FieldType
  placeholder String?
  helpText    String?
  isRequired  Boolean   @default(false)
  order       Int

  dependsOnFieldKey String?
  linkedToValue     String?
  allowOther        Boolean @default(false)
  isRepeater        Boolean @default(false)

  defaultValue         String? @db.Text
  defaultJson          Json?
  autoSelectWhenLinked Boolean @default(false)

  options DynamicFieldOption[]
  values  CaseValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stepId])
  @@index([key])
  @@index([order])
}

model DynamicFieldOption {
  id      String       @id @default(cuid())
  fieldId String
  field   DynamicField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  label         String  @db.Text
  value         String
  order         Int
  linkedToValue String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fieldId])
  @@index([value])
}

model CaseEntry {
  id String @id @default(cuid())

  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  workflowId       String?
  workflow         Workflow?        @relation(fields: [workflowId], references: [id])
  workflowSnapshot Json?
  guidanceReports  GuidanceReport[]
  studentId        String?
  student          Student?         @relation(fields: [studentId], references: [id])

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  title       String?
  status      CaseStatus @default(DRAFT)
  submittedAt DateTime?

  values             CaseValue[]
  evidences          Evidence[]
  calendarReminders  CalendarReminder[]
  activityAssignment ActivityAssignment? @relation("ActivityAssignmentCaseEntry")

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  caseEvidences          CaseEvidence[]
  createdReportTemplates ReportTemplate[]

  @@index([schoolAccountId])
  @@index([serviceId])
  @@index([workflowId])
  @@index([studentId])
  @@index([status])
}

model CaseValue {
  id String @id @default(cuid())

  caseEntryId String
  caseEntry   CaseEntry @relation(fields: [caseEntryId], references: [id], onDelete: Cascade)

  fieldId String?
  field   DynamicField? @relation(fields: [fieldId], references: [id])

  fieldKey  String
  value     String? @db.Text
  jsonValue Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseEntryId])
  @@index([fieldKey])
}

model Evidence {
  id String @id @default(cuid())

  caseEntryId String
  caseEntry   CaseEntry @relation(fields: [caseEntryId], references: [id], onDelete: Cascade)

  type     EvidenceType
  fileName String?
  fileUrl  String?
  mimeType String?
  size     Int?
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseEntryId])
}

model ActivityAssignment {
  id String @id @default(cuid())

  schoolAccountId String
  schoolAccount   SchoolAccount @relation("ActivityAssignmentsBySchool", fields: [schoolAccountId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ActivityAssignmentsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  serviceId String
  service   Service @relation("ActivityAssignmentsService", fields: [serviceId], references: [id])

  workflowId String
  workflow   Workflow @relation("ActivityAssignmentsWorkflow", fields: [workflowId], references: [id])

  caseEntryId String?    @unique
  caseEntry   CaseEntry? @relation("ActivityAssignmentCaseEntry", fields: [caseEntryId], references: [id], onDelete: SetNull)

  domainSlug  String
  domainTitle String

  teacherName  String
  teacherPhone String
  teacherEmail String?

  teacherSignatureUrl String?
  teacherSignedName   String?
  teacherSignedAt     DateTime?

  dueDate DateTime?
  note    String?   @db.Text

  submittedValues        Json?
  submittedEvidenceItems Json?
  returnedReason         String? @db.Text

  token          String    @unique
  tokenExpiresAt DateTime?

  openedAt    DateTime?
  submittedAt DateTime?
  approvedAt  DateTime?
  returnedAt  DateTime?
  canceledAt  DateTime?

  status ActivityAssignmentStatus @default(SENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
  @@index([createdById])
  @@index([serviceId])
  @@index([workflowId])
  @@index([domainSlug])
  @@index([teacherPhone])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
}

model CalendarReminder {
  id String @id @default(cuid())

  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  title String
  note  String?

  status   CalendarReminderStatus   @default(PENDING)
  priority CalendarReminderPriority @default(NORMAL)
  linkType CalendarReminderLinkType @default(GENERAL)

  scheduledAt         DateTime
  remindBeforeMinutes Int?

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  caseEntryId String?
  caseEntry   CaseEntry? @relation(fields: [caseEntryId], references: [id], onDelete: SetNull)

  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  completedAt   DateTime?
  completedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([scheduledAt])
  @@index([serviceId])
  @@index([caseEntryId])
  @@index([studentId])
}

model ExportTemplate {
  id          String  @id @default(cuid())
  serviceSlug String?
  name        String
  content     String
  isDefault   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceSlug])
}

model Plan {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  priceMonthly Int     @default(0)
  priceYearly  Int     @default(0)
  isActive     Boolean @default(true)
  isPublic     Boolean @default(true)
  isArchived   Boolean @default(false)
  visibleRoles Json?

  features      PlanFeature[]
  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanFeature {
  id     String @id @default(cuid())
  planId String
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  key   String
  label String
  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([key])
}

model Subscription {
  id              String        @id @default(cuid())
  schoolAccountId String        @unique
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  planId String
  plan   Plan   @relation(fields: [planId], references: [id])

  status   SubscriptionStatus @default(TRIAL)
  startsAt DateTime           @default(now())
  endsAt   DateTime?

  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceAccess {
  id              String        @id @default(cuid())
  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  isEnabled Boolean @default(true)
  isPaid    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolAccountId, serviceId])
}

model FeatureFlag {
  id        String  @id @default(cuid())
  key       String  @unique
  label     String
  isEnabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UsageLimit {
  id         String @id @default(cuid())
  planSlug   String
  featureKey String
  limit      Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planSlug, featureKey])
}

model UsageRecord {
  id              String @id @default(cuid())
  schoolAccountId String
  featureKey      String
  amount          Int    @default(1)

  createdAt DateTime @default(now())

  @@index([schoolAccountId])
  @@index([featureKey])
}

model PaymentProvider {
  id         String  @id @default(cuid())
  name       String
  slug       String  @unique
  isActive   Boolean @default(false)
  configJson Json?

  transactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])

  providerId String?
  provider   PaymentProvider? @relation(fields: [providerId], references: [id])

  amount       Int
  currency     String        @default("SAR")
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  externalRef  String?
  metadataJson Json?

  invoice Invoice?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([providerId])
  @@index([status])
}

model BankTransferRequest {
  id              String        @id @default(cuid())
  schoolAccountId String
  amount          Int
  currency        String        @default("SAR")
  senderName      String?
  receiptUrl      String?
  status          PaymentStatus @default(PENDING)
  adminNote       String?

  planId          String?
  durationDays    Int?
  requesterUserId String?
  billingCycle    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
  @@index([status])
}

model ManualActivation {
  id              String    @id @default(cuid())
  schoolAccountId String
  activatedById   String?
  reason          String?
  startsAt        DateTime  @default(now())
  endsAt          DateTime?

  createdAt DateTime @default(now())

  @@index([schoolAccountId])
}

model IntegrationProvider {
  id     String            @id @default(cuid())
  name   String
  slug   String            @unique
  status IntegrationStatus @default(INACTIVE)

  credentials ApiCredential[]
  webhooks    WebhookEvent[]
  syncLogs    ExternalSyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiCredential {
  id         String              @id @default(cuid())
  providerId String
  provider   IntegrationProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  label          String
  keyName        String
  encryptedValue String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId])
}

model WebhookEvent {
  id         String               @id @default(cuid())
  providerId String?
  provider   IntegrationProvider? @relation(fields: [providerId], references: [id])

  eventType   String
  payloadJson Json?
  processed   Boolean   @default(false)
  processedAt DateTime?

  createdAt DateTime @default(now())

  @@index([providerId])
  @@index([processed])
}

model ExternalSyncLog {
  id         String               @id @default(cuid())
  providerId String?
  provider   IntegrationProvider? @relation(fields: [providerId], references: [id])

  entityType String
  entityId   String?
  status     String
  message    String?

  createdAt DateTime @default(now())

  @@index([providerId])
  @@index([entityType])
}

model AssessmentAnalysis {
  id              String         @id @default(cuid())
  schoolAccountId String?
  schoolAccount   SchoolAccount? @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  title      String
  sourceFile String?
  status     String  @default("COMPLETED")
  uploadMode String  @default("GENERAL")

  totalStudents     Int    @default(0)
  totalRows         Int    @default(0)
  totalSubjects     Int    @default(0)
  averagePercentage Float?

  summaryJson Json?
  rowsJson    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
  @@index([status])
  @@index([createdAt])
}

model ResultsAnalysis {
  id              String         @id @default(cuid())
  schoolAccountId String?
  schoolAccount   SchoolAccount? @relation(fields: [schoolAccountId], references: [id])

  title      String
  grade      String?
  classroom  String?
  sourceFile String?
  status     String  @default("COMPLETED")

  totalStudents Int    @default(0)
  totalSubjects Int    @default(0)
  averageScore  Float?

  summaryJson Json?
  rowsJson    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolAccountId])
  @@index([grade])
  @@index([classroom])
}

enum ReportStatus {
  DRAFT
  GENERATED
  APPROVED
  ARCHIVED
}

enum ReportTwoStatus {
  DRAFT
  APPROVED
}

