  stage    String?
  grade    String?
  isActive Boolean @default(true)

  subjects        TimetableClassSubject[]
  assignments     TimetableAssignment[]
  constraintLinks TimetableConstraintClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([stage])
  @@index([grade])
  @@index([isActive])
}

model TimetableSubject {
  id String @id @default(cuid())

  projectId String
  project   TimetableProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

