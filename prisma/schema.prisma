enum TimetableProjectStatus {
  DRAFT
  READY
  GENERATED
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum TimetableAbsenceType {
  FULL_DAY
  SELECTED_PERIODS
  LATE_ARRIVAL
  EARLY_DEPARTURE
}

enum TimetableAbsenceStatus {
  DRAFT
  ACTIVE
  CLOSED
  CANCELED
}

enum TimetableSubstitutionStatus {
  PENDING
  SUGGESTED
  ASSIGNED
  NOTIFIED
  COMPLETED
  DECLINED
  REASSIGNED
  CANCELED
}

enum TimetableSupervisionType {
  MORNING
  BREAK
  GATE
  END_OF_DAY
  PRAYER
  BUS
  FLOOR
  CUSTOM
}

enum TimetableSupervisionStatus {
  DRAFT
  ASSIGNED
  COMPLETED
  CANCELED
}

model TimetableProject {
  id String @id @default(cuid())

  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("TimetableProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  name         String
  academicYear String
  semester     String

  status TimetableProjectStatus @default(DRAFT)

  daysJson     Json
  periodsJson  Json
  settingsJson Json?

  teachers          TimetableTeacher[]
  classes           TimetableClass[]
  subjects          TimetableSubject[]
  classSubjects     TimetableClassSubject[]
  assignments       TimetableAssignment[]
  waitingPolicy     TimetableWaitingPolicy?
  dailyAbsences     TimetableDailyAbsence[]
  substitutions     TimetableSubstitution[]
  supervisionDuties TimetableSupervisionDuty[]
  constraints       TimetableConstraint[]

  schedules      TimetableSchedule[]
  historyEntries TimetableProjectHistoryEntry[]
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@index([schoolAccountId])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
}

model TimetableProjectHistoryEntry {
  id String @id @default(cuid())

  projectId String
  project   TimetableProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  schoolAccountId String
  schoolAccount   SchoolAccount @relation(fields: [schoolAccountId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorUser   User?   @relation("TimetableHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  revertedByUserId String?
  revertedByUser   User?   @relation("TimetableHistoryReverter", fields: [revertedByUserId], references: [id], onDelete: SetNull)

  actionType String
  entityType String?
  entityId   String?
  state      String  @default("ACTIVE")

  beforeJson   Json?
  afterJson    Json?
  metadataJson Json?

  revertedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([projectId, createdAt])
  @@index([projectId, state, createdAt])
  @@index([schoolAccountId, createdAt])
  @@index([entityId])
}

model TimetableTeacher {
  id String @id @default(cuid())

  projectId String
  project   TimetableProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name          String
  specialty     String?
  maxWeeklyLoad Int     @default(24)
  isActive      Boolean @default(true)

  unavailableSlotsJson Json?

  assignments            TimetableAssignment[]
  dailyAbsences          TimetableDailyAbsence[]
  originalSubstitutions  TimetableSubstitution[]          @relation("OriginalSubstitutionTeacher")
  assignedSubstitutions  TimetableSubstitution[]          @relation("AssignedSubstitutionTeacher")
  supervisionAssignments TimetableSupervisionAssignment[]
  constraintLinks        TimetableConstraintTeacher[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@index([isActive])
}

model TimetableClass {
  id String @id @default(cuid())

  projectId String
  project   TimetableProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

