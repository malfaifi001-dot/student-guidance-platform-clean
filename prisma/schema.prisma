  constraintId String
  constraint   TimetableConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade, map: "TCC_constraint_fk")

  classId String
  class   TimetableClass @relation(fields: [classId], references: [id], onDelete: Cascade, map: "TCC_class_fk")

  @@unique([constraintId, classId], map: "TCC_constraint_class_key")
  @@index([classId], map: "TCC_class_idx")
