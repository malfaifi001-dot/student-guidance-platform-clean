  assignments     TimetableAssignment[]
  constraintLinks TimetableConstraintSubject[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
  @@index([catalogKey])
  @@index([isActive])
}

model TimetableClassSubject {
