  @@unique([constraintId, dayId], map: "TCD_constraint_day_key")
  @@index([dayId], map: "TCD_day_idx")
}

model TimetableConstraintPeriod {
  id String @id @default(cuid())

  constraintId String
  constraint   TimetableConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade, map: "TCP_constraint_fk")

  periodId String

  @@unique([constraintId, periodId], map: "TCP_constraint_period_key")
  @@index([periodId], map: "TCP_period_idx")
}

model TimetableConstraintSlot {
  id String @id @default(cuid())

  constraintId String
  constraint   TimetableConstraint @relation(fields: [constraintId], references: [id], onDelete: Cascade, map: "TCL_constraint_fk")

  dayId    String
  periodId String

  @@unique([constraintId, dayId, periodId], map: "TCL_constraint_slot_key")
  @@index([dayId, periodId], map: "TCL_slot_idx")
