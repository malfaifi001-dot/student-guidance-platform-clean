cd D:\student-guidance-platform-clean

$utf8NoBom = New-Object System.Text.UTF8Encoding($false)
$patchPath = "report-2-restore-before-git-restore.patch"

$patch = Get-Clipboard -Raw

if (-not $patch.StartsWith("diff --git ")) {
  throw "الـ Clipboard لا يبدأ بـ diff --git. انسخ محتوى ملف diff كاملًا أولًا."
}

[System.IO.File]::WriteAllText($patchPath, $patch, $utf8NoBom)

git apply --whitespace=nowarn $patchPath

git --no-pager diff -- components/report-2/report-two-studio-runtime.tsx

npm run build